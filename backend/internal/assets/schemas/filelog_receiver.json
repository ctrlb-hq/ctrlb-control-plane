{
  "title": "Filelog Receiver Configuration",
  "type": "object",
  "properties": {
    "include": {
      "type": "array",
      "title": "Include File Paths",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [
        ""
      ]
    },
    "exclude": {
      "type": "array",
      "title": "Exclude File Paths",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "start_at": {
      "type": "string",
      "title": "Start At",
      "enum": [
        "beginning",
        "end"
      ],
      "default": "end",
      "minLength": 1
    },
    "poll_interval": {
      "type": "string",
      "title": "Poll Interval",
      "default": "200ms"
    },
    "fingerprint_size": {
      "type": "string",
      "title": "Fingerprint size",
      "default": "1kb"
    },
    "max_log_size": {
      "type": "string",
      "title": "Maximum log size",
      "default": "1MiB"
    },
    "encoding": {
      "type": "string",
      "title": "Encoding",
      "default": "utf-8",
      "minLength": 1
    },
    "operators": {
      "type": "array",
      "title": "Operators",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "title": "Operator Type",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "title": "Operator ID",
            "minLength": 1
          },
          "regex": {
            "type": "string",
            "title": "Regex Pattern"
          },
          "parse_from": {
            "type": "string",
            "title": "Parse From Field"
          },
          "add_metadata_from_filepath": {
            "type": "boolean",
            "title": "Extract Kubernetes metadata from file path",
            "default": true
          }
        },
        "required": [
          "type",
          "id"
        ]
      },
      "default": []
    },
    "include_file_path": {
      "type": "boolean",
      "title": "Include file path for container metadata",
      "default": true
    },
    "storage": {
      "type": "string",
      "title": "Offset storage extension",
      "description": "file_storage persists offsets in the node state directory."
    }
  },
  "required": [
    "include"
  ]
}
