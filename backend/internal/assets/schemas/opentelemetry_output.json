{
  "title": "Fluent Bit OpenTelemetry Output Configuration",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "title": "Host",
      "description": "IP address or hostname of the target HTTP server.",
      "default": "127.0.0.1"
    },
    "port": {
      "type": "integer",
      "title": "Port",
      "description": "TCP port of the target HTTP server.",
      "default": 80
    },
    "logs_uri": {
      "type": "string",
      "title": "Logs URI",
      "description": "HTTP URI for the logs OTel endpoint.",
      "default": "/v1/logs"
    },
    "metrics_uri": {
      "type": "string",
      "title": "Metrics URI",
      "description": "HTTP URI for the metrics OTel endpoint.",
      "default": "/v1/metrics"
    },
    "traces_uri": {
      "type": "string",
      "title": "Traces URI",
      "description": "HTTP URI for the traces OTel endpoint.",
      "default": "/v1/traces"
    },
    "profiles_uri": {
      "type": "string",
      "title": "Profiles URI",
      "description": "HTTP URI for the profiles OTel endpoint.",
      "default": "/v1development/profiles"
    },
    "proxy": {
      "type": "string",
      "title": "Proxy",
      "description": "HTTP Proxy in format http://host:port."
    },
    "http2": {
      "type": "string",
      "title": "HTTP/2",
      "description": "Enable, disable or force HTTP/2 usage.",
      "enum": ["on", "off", "force"],
      "default": "off"
    },
    "grpc": {
      "type": "string",
      "title": "gRPC",
      "description": "Enable, disable or auto-detect gRPC usage.",
      "enum": ["on", "off", "auto"],
      "default": "off"
    },
    "grpc_logs_uri": {
      "type": "string",
      "title": "gRPC Logs URI",
      "description": "gRPC URI for logs endpoint.",
      "default": "/opentelemetry.proto.collector.logs.v1.LogsService/Export"
    },
    "grpc_metrics_uri": {
      "type": "string",
      "title": "gRPC Metrics URI",
      "description": "gRPC URI for metrics endpoint.",
      "default": "/opentelemetry.proto.collector.metrics.v1.MetricsService/Export"
    },
    "grpc_traces_uri": {
      "type": "string",
      "title": "gRPC Traces URI",
      "description": "gRPC URI for traces endpoint.",
      "default": "/opentelemetry.proto.collector.trace.v1.TraceService/Export"
    },
    "grpc_profiles_uri": {
      "type": "string",
      "title": "gRPC Profiles URI",
      "description": "gRPC URI for profiles endpoint.",
      "default": "/opentelemetry.proto.collector.profiles.v1experimental.ProfilesService/Export"
    },
    "compress": {
      "type": "string",
      "title": "Compress",
      "description": "Payload compression mechanism.",
      "enum": ["gzip", "zstd", ""]
    },
    "batch_size": {
      "type": "integer",
      "title": "Batch Size",
      "description": "Maximum number of log records to flush at a time.",
      "default": 1000
    },
    "http_user": {
      "type": "string",
      "title": "HTTP User",
      "description": "HTTP auth username."
    },
    "http_passwd": {
      "type": "string",
      "title": "HTTP Password",
      "description": "HTTP auth password."
    },
    "header": {
      "type": "array",
      "title": "Headers",
      "description": "HTTP header key/value pairs. Format: Key Value",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "add_label": {
      "type": "array",
      "title": "Add Labels",
      "description": "Custom labels for metrics. Format: name value",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tls": {
      "type": "string",
      "title": "TLS",
      "description": "Enable or disable TLS/SSL support.",
      "enum": ["on", "off"],
      "default": "off"
    },
    "tls_verify": {
      "type": "string",
      "title": "TLS Verify",
      "description": "Force certificate validation.",
      "enum": ["on", "off"],
      "default": "on"
    },
    "tls_verify_hostname": {
      "type": "string",
      "title": "TLS Verify Hostname",
      "description": "Verify hostname in certificate.",
      "enum": ["on", "off"],
      "default": "off"
    },
    "tls_ca_file": {
      "type": "string",
      "title": "TLS CA File",
      "description": "Absolute path to CA certificate file."
    },
    "tls_ca_path": {
      "type": "string",
      "title": "TLS CA Path",
      "description": "Absolute path to scan for certificate files."
    },
    "tls_crt_file": {
      "type": "string",
      "title": "TLS Certificate File",
      "description": "Absolute path to certificate file."
    },
    "tls_key_file": {
      "type": "string",
      "title": "TLS Key File",
      "description": "Absolute path to private key file."
    },
    "tls_key_passwd": {
      "type": "string",
      "title": "TLS Key Password",
      "description": "Password for TLS private key file."
    },
    "tls_vhost": {
      "type": "string",
      "title": "TLS Virtual Host",
      "description": "Hostname for TLS SNI extension."
    },
    "tls_debug": {
      "type": "integer",
      "title": "TLS Debug",
      "description": "TLS debug level: 0=None, 1=Error, 2=State, 3=Info, 4=Verbose.",
      "default": 1
    },
    "tls_min_version": {
      "type": "string",
      "title": "TLS Min Version",
      "description": "Minimum TLS version."
    },
    "tls_max_version": {
      "type": "string",
      "title": "TLS Max Version",
      "description": "Maximum TLS version."
    },
    "tls_ciphers": {
      "type": "string",
      "title": "TLS Ciphers",
      "description": "TLS ciphers for up to TLSv1.2."
    },
    "logs_body_key": {
      "type": "string",
      "title": "Logs Body Key",
      "description": "Key to use for log body."
    },
    "logs_body_key_attributes": {
      "type": "boolean",
      "title": "Logs Body Key Attributes",
      "description": "Include remaining fields as attributes when body key matches.",
      "default": false
    },
    "logs_span_id_message_key": {
      "type": "string",
      "title": "Logs Span ID Message Key",
      "description": "Key for SpanId in message.",
      "default": "$SpanId"
    },
    "logs_span_id_metadata_key": {
      "type": "string",
      "title": "Logs Span ID Metadata Key",
      "description": "Key for SpanId in metadata.",
      "default": "$SpanId"
    },
    "logs_trace_id_message_key": {
      "type": "string",
      "title": "Logs Trace ID Message Key",
      "description": "Key for TraceId in message.",
      "default": "$TraceId"
    },
    "logs_trace_id_metadata_key": {
      "type": "string",
      "title": "Logs Trace ID Metadata Key",
      "description": "Key for TraceId in metadata.",
      "default": "$TraceId"
    },
    "logs_trace_flags_metadata_key": {
      "type": "string",
      "title": "Logs Trace Flags Metadata Key",
      "description": "Key for TraceFlags.",
      "default": "$TraceFlags"
    },
    "logs_severity_text_message_key": {
      "type": "string",
      "title": "Logs Severity Text Message Key",
      "description": "Key for SeverityText in message.",
      "default": "$SeverityText"
    },
    "logs_severity_text_metadata_key": {
      "type": "string",
      "title": "Logs Severity Text Metadata Key",
      "description": "Key for SeverityText in metadata.",
      "default": "$SeverityText"
    },
    "logs_severity_number_message_key": {
      "type": "string",
      "title": "Logs Severity Number Message Key",
      "description": "Key for SeverityNumber in message.",
      "default": "$severityNumber"
    },
    "logs_severity_number_metadata_key": {
      "type": "string",
      "title": "Logs Severity Number Metadata Key",
      "description": "Key for SeverityNumber in metadata.",
      "default": "$SeverityNumber"
    },
    "logs_timestamp_metadata_key": {
      "type": "string",
      "title": "Logs Timestamp Metadata Key",
      "description": "Key for Timestamp.",
      "default": "$Timestamp"
    },
    "logs_observed_timestamp_metadata_key": {
      "type": "string",
      "title": "Logs Observed Timestamp Metadata Key",
      "description": "Key for ObservedTimestamp.",
      "default": "$ObservedTimestamp"
    },
    "logs_attributes_metadata_key": {
      "type": "string",
      "title": "Logs Attributes Metadata Key",
      "description": "Key for Attributes.",
      "default": "$Attributes"
    },
    "logs_resource_metadata_key": {
      "type": "string",
      "title": "Logs Resource Metadata Key",
      "description": "Key for Resource.",
      "default": "Resource"
    },
    "logs_instrumentation_scope_metadata_key": {
      "type": "string",
      "title": "Logs Instrumentation Scope Metadata Key",
      "description": "Key for InstrumentationScope.",
      "default": "InstrumentationScope"
    },
    "logs_metadata_key": {
      "type": "string",
      "title": "Logs Metadata Key",
      "description": "Key to look up in metadata.",
      "default": "otlp"
    },
    "logs_max_resources": {
      "type": "integer",
      "title": "Logs Max Resources",
      "description": "Maximum OTLP log resources per request. 0 disables limit.",
      "default": 0
    },
    "logs_max_scopes": {
      "type": "integer",
      "title": "Logs Max Scopes",
      "description": "Maximum OTLP log scopes per resource. 0 disables limit.",
      "default": 0
    },
    "log_response_payload": {
      "type": "boolean",
      "title": "Log Response Payload",
      "description": "Log the response payload.",
      "default": true
    },
    "aws_auth": {
      "type": "boolean",
      "title": "AWS Auth",
      "description": "Enable AWS SigV4 authentication.",
      "default": false
    },
    "aws_service": {
      "type": "string",
      "title": "AWS Service",
      "description": "AWS destination service code for SigV4.",
      "default": "logs"
    },
    "aws_region": {
      "type": "string",
      "title": "AWS Region",
      "description": "AWS region of your service."
    },
    "aws_role_arn": {
      "type": "string",
      "title": "AWS Role ARN",
      "description": "ARN of IAM role to assume."
    },
    "aws_external_id": {
      "type": "string",
      "title": "AWS External ID",
      "description": "External ID for the STS API."
    },
    "aws_profile": {
      "type": "string",
      "title": "AWS Profile",
      "description": "AWS Profile name."
    },
    "aws_sts_endpoint": {
      "type": "string",
      "title": "AWS STS Endpoint",
      "description": "Custom endpoint for AWS STS API."
    },
    "retry_limit": {
      "type": "string",
      "title": "Retry Limit",
      "description": "Retry limit on delivery failure. Integer, no_limits, false, off, or no_retries.",
      "default": "1"
    },
    "net_connect_timeout": {
      "type": "string",
      "title": "Connect Timeout",
      "description": "Maximum time to establish connection including TLS handshake.",
      "default": "10s"
    },
    "net_io_timeout": {
      "type": "string",
      "title": "IO Timeout",
      "description": "Maximum time a connection can stay idle.",
      "default": "0s"
    },
    "net_tcp_keepalive": {
      "type": "string",
      "title": "TCP Keepalive",
      "description": "Enable or disable TCP keepalive.",
      "enum": ["on", "off"],
      "default": "off"
    },
    "net_keepalive_max_recycle": {
      "type": "integer",
      "title": "Keepalive Max Recycle",
      "description": "Maximum times a keepalive connection can be reused.",
      "default": 2000
    }
  },
  "required": [
    "host"
  ]
}

