{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Group",
      "label": "Connection Settings",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/host",
          "label": "Host"
        },
        {
          "type": "Control",
          "scope": "#/properties/port",
          "label": "Port"
        },
        {
          "type": "Control",
          "scope": "#/properties/uri",
          "label": "URI"
        },
        {
          "type": "Control",
          "scope": "#/properties/tls",
          "label": "TLS"
        },
        {
          "type": "Control",
          "scope": "#/properties/compress",
          "label": "Compress"
        }
      ]
    },
    {
      "type": "Group",
      "label": "Authentication",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/http_user",
          "label": "HTTP User"
        },
        {
          "type": "Control",
          "scope": "#/properties/http_passwd",
          "label": "HTTP Password",
          "options": {
            "format": "password"
          }
        }
      ]
    },
    {
      "type": "Group",
      "label": "Format Settings",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/format",
          "label": "Format"
        },
        {
          "type": "Control",
          "scope": "#/properties/json_date_key",
          "label": "JSON Date Key"
        },
        {
          "type": "Control",
          "scope": "#/properties/json_date_format",
          "label": "JSON Date Format"
        }
      ]
    },
    {
      "type": "Group",
      "label": "Tag Settings",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/include_tag_key",
          "label": "Include Tag Key"
        },
        {
          "type": "Control",
          "scope": "#/properties/tag_key",
          "label": "Tag Key",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/include_tag_key",
              "schema": {
                "const": true
              }
            }
          }
        }
      ]
    }
  ]
}

