{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Group",
      "label": "Connection Settings",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/host",
          "label": "Host"
        },
        {
          "type": "Control",
          "scope": "#/properties/port",
          "label": "Port"
        },
        {
          "type": "Control",
          "scope": "#/properties/proxy",
          "label": "Proxy"
        },
        {
          "type": "Control",
          "scope": "#/properties/http2",
          "label": "HTTP/2"
        },
        {
          "type": "Control",
          "scope": "#/properties/compress",
          "label": "Compress"
        },
        {
          "type": "Control",
          "scope": "#/properties/batch_size",
          "label": "Batch Size"
        }
      ]
    },
    {
      "type": "Group",
      "label": "HTTP Endpoints",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/logs_uri",
          "label": "Logs URI"
        },
        {
          "type": "Control",
          "scope": "#/properties/metrics_uri",
          "label": "Metrics URI"
        },
        {
          "type": "Control",
          "scope": "#/properties/traces_uri",
          "label": "Traces URI"
        },
        {
          "type": "Control",
          "scope": "#/properties/profiles_uri",
          "label": "Profiles URI"
        }
      ]
    },
    {
      "type": "Group",
      "label": "gRPC Settings",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/grpc",
          "label": "gRPC"
        },
        {
          "type": "Control",
          "scope": "#/properties/grpc_logs_uri",
          "label": "gRPC Logs URI",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/grpc",
              "schema": {
                "enum": ["on", "auto"]
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/grpc_metrics_uri",
          "label": "gRPC Metrics URI",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/grpc",
              "schema": {
                "enum": ["on", "auto"]
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/grpc_traces_uri",
          "label": "gRPC Traces URI",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/grpc",
              "schema": {
                "enum": ["on", "auto"]
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/grpc_profiles_uri",
          "label": "gRPC Profiles URI",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/grpc",
              "schema": {
                "enum": ["on", "auto"]
              }
            }
          }
        }
      ]
    },
    {
      "type": "Group",
      "label": "Authentication",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/http_user",
          "label": "HTTP User"
        },
        {
          "type": "Control",
          "scope": "#/properties/http_passwd",
          "label": "HTTP Password",
          "options": {
            "format": "password"
          }
        }
      ]
    },
    {
      "type": "Group",
      "label": "Headers & Labels",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/header",
          "label": "Custom Headers",
          "options": {
            "showSortButtons": true
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/add_label",
          "label": "Add Labels",
          "options": {
            "showSortButtons": true
          }
        }
      ]
    },
    {
      "type": "Group",
      "label": "TLS Settings",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/tls",
          "label": "TLS"
        },
        {
          "type": "Control",
          "scope": "#/properties/tls_verify",
          "label": "TLS Verify",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/tls",
              "schema": {
                "const": "on"
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/tls_verify_hostname",
          "label": "TLS Verify Hostname",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/tls",
              "schema": {
                "const": "on"
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/tls_ca_file",
          "label": "TLS CA File",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/tls",
              "schema": {
                "const": "on"
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/tls_ca_path",
          "label": "TLS CA Path",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/tls",
              "schema": {
                "const": "on"
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/tls_crt_file",
          "label": "TLS Certificate File",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/tls",
              "schema": {
                "const": "on"
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/tls_key_file",
          "label": "TLS Key File",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/tls",
              "schema": {
                "const": "on"
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/tls_key_passwd",
          "label": "TLS Key Password",
          "options": {
            "format": "password"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/tls",
              "schema": {
                "const": "on"
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/tls_vhost",
          "label": "TLS Virtual Host",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/tls",
              "schema": {
                "const": "on"
              }
            }
          }
        }
      ]
    },
    {
      "type": "Group",
      "label": "Logs Configuration",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/logs_body_key",
          "label": "Logs Body Key"
        },
        {
          "type": "Control",
          "scope": "#/properties/logs_body_key_attributes",
          "label": "Logs Body Key Attributes"
        },
        {
          "type": "Control",
          "scope": "#/properties/logs_span_id_message_key",
          "label": "Logs Span ID Message Key"
        },
        {
          "type": "Control",
          "scope": "#/properties/logs_trace_id_message_key",
          "label": "Logs Trace ID Message Key"
        },
        {
          "type": "Control",
          "scope": "#/properties/logs_severity_text_message_key",
          "label": "Logs Severity Text Message Key"
        },
        {
          "type": "Control",
          "scope": "#/properties/logs_severity_number_message_key",
          "label": "Logs Severity Number Message Key"
        },
        {
          "type": "Control",
          "scope": "#/properties/logs_metadata_key",
          "label": "Logs Metadata Key"
        },
        {
          "type": "Control",
          "scope": "#/properties/logs_max_resources",
          "label": "Logs Max Resources"
        },
        {
          "type": "Control",
          "scope": "#/properties/logs_max_scopes",
          "label": "Logs Max Scopes"
        },
        {
          "type": "Control",
          "scope": "#/properties/log_response_payload",
          "label": "Log Response Payload"
        }
      ]
    },
    {
      "type": "Group",
      "label": "AWS Authentication",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/aws_auth",
          "label": "AWS Auth"
        },
        {
          "type": "Control",
          "scope": "#/properties/aws_service",
          "label": "AWS Service",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/aws_auth",
              "schema": {
                "const": true
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/aws_region",
          "label": "AWS Region",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/aws_auth",
              "schema": {
                "const": true
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/aws_role_arn",
          "label": "AWS Role ARN",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/aws_auth",
              "schema": {
                "const": true
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/aws_external_id",
          "label": "AWS External ID",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/aws_auth",
              "schema": {
                "const": true
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/aws_profile",
          "label": "AWS Profile",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/aws_auth",
              "schema": {
                "const": true
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/aws_sts_endpoint",
          "label": "AWS STS Endpoint",
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/aws_auth",
              "schema": {
                "const": true
              }
            }
          }
        }
      ]
    },
    {
      "type": "Group",
      "label": "Advanced Settings",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/retry_limit",
          "label": "Retry Limit"
        },
        {
          "type": "Control",
          "scope": "#/properties/net_connect_timeout",
          "label": "Connect Timeout"
        },
        {
          "type": "Control",
          "scope": "#/properties/net_io_timeout",
          "label": "IO Timeout"
        },
        {
          "type": "Control",
          "scope": "#/properties/net_tcp_keepalive",
          "label": "TCP Keepalive"
        },
        {
          "type": "Control",
          "scope": "#/properties/net_keepalive_max_recycle",
          "label": "Keepalive Max Recycle"
        }
      ]
    }
  ]
}

